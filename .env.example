# === BRAND'S Brain Camp — Tech & AI Playground ===
# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าตามงาน

# URL สาธารณะที่น้องสแกน = public hostname ของ Cloudflare Tunnel
# ตั้งค่านี้ไว้ พี่จะเปิด /present ที่ localhost ได้เลยโดย QR ยังชี้โดเมนถูก
# ระบบต่อท้าย /join ให้เอง — เว้นว่าง = ใช้ origin ของหน้าที่เปิดอยู่ / กรอกสดในหน้า /present
NEXT_PUBLIC_JOIN_URL=https://braincamp.ponggun.com

# ตั้งเป็น 1 เพื่อรันโหมดสำรอง (client-only) ที่หน้า /join ทำงานได้เองโดยไม่ต้องมี server
# ใช้ตอน deploy build สำรองขึ้น Vercel — ปล่อยว่าง = โหมดปกติ (มี live dashboard)
NEXT_PUBLIC_STATIC_MODE=

# รหัสป้องกันปุ่มคุมของ presenter — ต้องกรอกรหัสนี้ในหน้า /present ก่อนจึงจะเปิด/ปิด/ล้างกิจกรรมได้
# ปล่อยว่าง = ใครก็สั่งได้ (โอเคตอน dev แต่ "ต้องตั้ง" เมื่อเปิดผ่าน tunnel ออกเน็ตจริง)
PRESENTER_KEY=
