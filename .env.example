# === BRAND'S Brain Camp — Tech & AI Playground ===
# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าตามงาน

# URL สาธารณะที่น้องสแกน (โดยปกติคือ tunnel URL ของ ngrok / VS Code port forward)
# ระบบจะต่อท้ายด้วย /join ให้เอง — จะเว้นว่างไว้แล้วไปกรอกสดในหน้า /present ก็ได้
NEXT_PUBLIC_JOIN_URL=

# ตั้งเป็น 1 เพื่อรันโหมดสำรอง (client-only) ที่หน้า /join ทำงานได้เองโดยไม่ต้องมี server
# ใช้ตอน deploy build สำรองขึ้น Vercel — ปล่อยว่าง = โหมดปกติ (มี live dashboard)
NEXT_PUBLIC_STATIC_MODE=

# (ออปชัน) รหัสป้องกันปุ่มคุมของ presenter — ถ้าตั้งไว้ ต้องกรอกรหัสนี้ในหน้า /present
# ปล่อยว่าง = ใครก็คุมได้ (สะดวกตอน dev)
PRESENTER_KEY=
